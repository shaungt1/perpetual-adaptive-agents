{
  "name": "perpetual-adaptive-agents",
  "version": "0.2.0",
  "description": "Local, modular system that plans a project once, then runs many AI chat sessions (Claude Code, Codex, Copilot) as lane-bound workers coordinated through a NATS message board and a SQLite record store.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pa": "core/cli.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs tests/e2e/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "ui": "node core/cli.mjs ui",
    "start": "bash start.sh"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "smol-toml": "^1.3.1"
  }
}
