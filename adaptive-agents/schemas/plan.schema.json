{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Agents plan file (input to `pa plan import`)",
  "type": "object",
  "required": [
    "master_tasks",
    "agents"
  ],
  "properties": {
    "categories": {
      "$ref": "#/properties/departments",
      "description": "Older name for departments; either key works."
    },
    "master_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "kind",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-[0-9]{3,}$"
          },
          "category": {
            "type": "string",
            "description": "The department id"
          },
          "kind": {
            "enum": [
              "critical",
              "owner_request",
              "bug",
              "optimization",
              "feature",
              "research"
            ]
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "acceptance": {
            "type": "string"
          },
          "complexity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "source": {
            "type": "string",
            "description": "Vision line, gap finding, or owner request this task came from"
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [],
        "properties": {
          "name": {
            "type": "string",
            "description": "Optional; the system assigns a name such as Zorro-01"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "lane": {
            "type": "string"
          },
          "persona": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "claude",
              "codex",
              "copilot",
              "mock"
            ]
          },
          "model": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Master task ids for this agent's first list, in order"
          },
          "departments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Department ids this agent owns (older name: categories)"
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Folders, documents and plans this agent should read"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "title",
          "path"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "made",
              "checked",
              "approved"
            ]
          }
        }
      }
    },
    "departments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "scope",
          "owns",
          "out_of_scope",
          "done_definition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "examples": [
              "C1"
            ]
          },
          "name": {
            "type": "string",
            "examples": [
              "API"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 10,
            "description": "What the department is responsible for, in concrete terms"
          },
          "owns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "The files and folders only this department changes"
          },
          "out_of_scope": {
            "type": "string",
            "minLength": 10,
            "description": "What the department must not touch or do"
          },
          "done_definition": {
            "type": "string",
            "minLength": 10,
            "description": "What 'done' means for this department's work"
          },
          "description": {
            "type": "string",
            "description": "Optional extra description"
          }
        }
      }
    },
    "supervisor": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "departments"
      ]
    },
    {
      "required": [
        "categories"
      ]
    }
  ]
}
